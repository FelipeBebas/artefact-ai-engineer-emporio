# Configurações do Agente Empório da Música

# Escolha do Provedor de LLM: "openai", "google" ou "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Chaves de API (preencha a do provedor escolhido)
OPENAI_API_KEY=sua_chave_google_aqui
GOOGLE_API_KEY=sua_chave_google_aqui
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Caminho do Banco de Dados SQLite local
DB_PATH=emporio.db
